@app.get("/api/activity")
def get_activity():
    activity_file = os.path.join(BASE_DIR, "system-graph", indexer.active_space, "activity.json")
    if not os.path.exists(activity_file):
        return {"type": None, "nodes": []}
    
    # Check if the file is older than 10 seconds
    mtime = os.path.getmtime(activity_file)
    if time.time() - mtime > 10:
        return {"type": None, "nodes": []}
        
    try:
        with open(activity_file, "r") as f:
            data = json.load(f)
            return data
    except Exception:
        return {"type": None, "nodes": []}

from fastapi import FastAPI, HTTPException, BackgroundTasks

is_syncing = False
current_indexed_chunks = 0

def on_indexer_update(documents, chunks):
    global current_indexed_chunks
    current_indexed_chunks = chunks

# Re-initialize indexer with the callback
indexer = OmniaIndexer(update_callback=on_indexer_update)

@app.post("/api/refresh")
async def refresh_all(background_tasks: BackgroundTasks):
    global is_syncing, current_indexed_chunks
    if is_syncing:
        return {"message": "Ya hay una sincronización en curso"}
        
    def run_sync():
        global is_syncing, current_indexed_chunks
        try:
            is_syncing = True
            current_indexed_chunks = 0
            docs, chunks = indexer.scan_all()
            dashboard.update_stats(documents=docs, chunks=chunks)
            current_indexed_chunks = chunks
        finally:
            is_syncing = False

    background_tasks.add_task(run_sync)
    return {"message": "Sincronización iniciada en segundo plano"}

@app.get("/api/status")
def get_status():
    if not indexer:
        return {"status": "offline"}
    
    if is_syncing:
        return {"status": "syncing", "documents_indexed": current_indexed_chunks}
    else:
        try:
            docs = indexer.collection.count()
        except:
            docs = current_indexed_chunks
        return {"status": "idle", "documents_indexed": docs}

@app.get("/buscar")
async def buscar(q: str, n: int = 5):
    if not indexer or not indexer.collection.count():
        return {"results": []}
        
    # 1. Búsqueda Semántica (ChromaDB)
    vector_results = indexer.collection.query(
        query_texts=[q],
        n_results=n * 2
    )
    
    # 2. Búsqueda Exacta (SQLite FTS5)
    fts_results = []
    try:
        # FTS5 match query requires specific syntax, replace spaces with OR/AND or just use raw query
        # Let's use simple phrase match or OR
        fts_query = " OR ".join(f'"{word}"' for word in q.split() if len(word) > 2)
        if not fts_query:
            fts_query = f'"{q}"'
            
        cursor = indexer.conn.cursor()
        table = f"omnia_search_{indexer.safe_space}"
        cursor.execute(f'''
            SELECT id, source, symbol, content
            FROM {table}
            WHERE {table} MATCH ?
            ORDER BY rank
            LIMIT ?
        ''', (fts_query, n * 2))
        fts_results = cursor.fetchall()
    except Exception as e:
        print(f"FTS5 Error: {e}")
        pass
        
    # 3. Reciprocal Rank Fusion (RRF)
    k = 60
    scores = {}
    docs_metadata = {}
    
    # RRF for Vector
    if vector_results["ids"] and vector_results["ids"][0]:
        for rank, doc_id in enumerate(vector_results["ids"][0]):
            scores[doc_id] = scores.get(doc_id, 0.0) + 1.0 / (k + rank + 1)
            docs_metadata[doc_id] = {
                "text": vector_results["documents"][0][rank],
                "meta": vector_results["metadatas"][0][rank],
                "source": "vector"
            }
            
    # RRF for FTS5
    for rank, row in enumerate(fts_results):
        doc_id, source, symbol, content = row
        scores[doc_id] = scores.get(doc_id, 0.0) + 1.0 / (k + rank + 1)
        if doc_id not in docs_metadata:
            docs_metadata[doc_id] = {
                "text": content,
                "meta": {"source": source, "symbol": symbol, "type": "fts"},
                "source": "exact"
            }
            
    # Ordenar por RRF Score
    ranked_docs = sorted(scores.items(), key=lambda x: x[1], reverse=True)
    
    final_results = []
    for doc_id, score in ranked_docs[:n]:
        doc_info = docs_metadata[doc_id]
        final_results.append({
            "id": doc_id,
            "text": doc_info["text"],
            "metadata": doc_info["meta"],
            "score": round(score, 4),
            "match_type": doc_info["source"]
        })

    # Log semantic search activity
    activity_file = os.path.join(BASE_DIR, "system-graph", indexer.active_space, "activity.json")
    try:
        os.makedirs(os.path.dirname(activity_file), exist_ok=True)
        with open(activity_file, "w") as f:
            import json
            nodes = [r["id"] for r in final_results]
            json.dump({"type": "semantic-search", "nodes": nodes}, f)
    except Exception as e:
        print(f"Error logging activity: {e}")

    await manager.broadcast({"type": "activity_update"})

    current_queries = dashboard.stats["queries_today"] + 1
    current_tokens = dashboard.stats["tokens_avoided"] + sum(len(r["text"])//4 for r in final_results)
    dashboard.update_stats(queries_today=current_queries, tokens_avoided=current_tokens)
    
    return {"results": final_results}

if __name__ == "__main__":
    print("Iniciando Omnia-RAG Backend en http://localhost:8000 ...")
    
    # Inicialización síncrona en el hilo principal antes de arrancar FastAPI
    # NO escaneamos todo aquí para no bloquear el arranque
    indexer = OmniaIndexer(update_callback=on_indexer_update)
    
    # Cargar los contadores del estado actual
    docs = indexer.collection.count()
    dashboard.update_stats(documents=docs, chunks=docs)
    
    # Arrancamos uvicorn pasando la app directamente para no recargar el módulo
    import uvicorn
    uvicorn.run(app, host="127.0.0.1", port=8000, log_level="info", access_log=False)
